# Server-only secrets. Never prefix these with EXPO_PUBLIC_.
#
# In production these do NOT come from this file. They live as Supabase secrets
# on the `nutrition` edge function:
#   supabase secrets set --env-file supabase/.env.gateway
# The values below are only read by the local `npm run api` gateway.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=openai/gpt-4.1-mini
VISION_IMAGE_DETAIL=high
OPENROUTER_ZDR=true

# Optional direct-OpenAI alternative: set AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

USDA_API_KEY=
PORT=8787

# LOCAL DEVELOPMENT ONLY. Points the app at `npm run api` on your Mac.
# Replace 192.168.1.20 with your Mac's Wi-Fi IP address.
# Leave this EMPTY in preview and production builds: the app then calls the
# hosted `nutrition` edge function, which is the only place the provider keys
# exist. A build that ships with this set would try to reach your laptop.
EXPO_PUBLIC_ANALYSIS_API_URL=http://192.168.1.20:8787

# Public Supabase client values from the project's Connect dialog.
# Use only the publishable key (sb_publishable_...), never a secret/service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public RevenueCat SDK keys. These identify the app; never add a RevenueCat secret API key here.
# Expo Go must use the RevenueCat Test Store key (test_...).
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
# Development/App Store builds use the platform-specific public SDK keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Optional RevenueCat Billing key for a separately configured web app.
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=kandro_pro

# Public PostHog project token for anonymous, allowlisted product analytics.
# Use the EU host for an EU PostHog project. Analytics stays off until explicitly enabled.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_ENABLED=false

# Public contact shown in the in-app privacy notice. Configure before external distribution.
EXPO_PUBLIC_LEGAL_CONTACT_EMAIL=
