{
  "name": "kandro",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "dotenv": "^17.2.3",
    "expo": "~54.0.0",
    "expo-application": "~7.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "posthog-react-native": "^4.66.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-purchases": "^10.8.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "supabase": "^2.116.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "api": "node server/index.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "db:remote:list": "SUPABASE_HOME=./supabase/.cli-home supabase migration list --linked --profile ./supabase/kandro.profile.yml",
    "db:remote:check": "SUPABASE_HOME=./supabase/.cli-home supabase db push --linked --dry-run --profile ./supabase/kandro.profile.yml",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validate:meals": "node scripts/validate-meal-cases.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "validate:product": "node scripts/validate-product-flow.mjs",
    "validate:supabase": "node scripts/validate-supabase.mjs",
    "validate:deletion:live": "node scripts/validate-account-deletion.mjs",
    "validate:subscription": "node scripts/validate-subscription.mjs",
    "doctor": "npx expo-doctor",
    "check": "npm run typecheck && npx expo export --platform web",
    "verify": "npm run typecheck && npm run validate:meals && npm run validate:catalog && npm run validate:product && npm run validate:supabase && npm run validate:subscription && node --check server/index.mjs && npm run doctor && npx expo export --platform web"
  },
  "private": true
}
