  "scripts": {
    "start": "expo start",
    "api": "node server/index.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "db:remote:list": "SUPABASE_HOME=./supabase/.cli-home supabase migration list --linked --profile ./supabase/kandro.profile.yml",
    "db:remote:check": "SUPABASE_HOME=./supabase/.cli-home supabase db push --linked --dry-run --profile ./supabase/kandro.profile.yml",
    "db:remote:push": "SUPABASE_HOME=./supabase/.cli-home supabase db push --linked --profile ./supabase/kandro.profile.yml",
    "gateway:secrets": "SUPABASE_HOME=./supabase/.cli-home supabase secrets set --env-file supabase/.env.gateway",
    "gateway:deploy": "SUPABASE_HOME=./supabase/.cli-home supabase functions deploy nutrition",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validate:meals": "node scripts/validate-meal-cases.mjs",
    "validate:german": "node scripts/validate-german-meals.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "validate:product": "node scripts/validate-product-flow.mjs",
    "validate:supabase": "node scripts/validate-supabase.mjs",
    "validate:deletion:live": "node scripts/validate-account-deletion.mjs",
    "validate:subscription": "node scripts/validate-subscription.mjs",
    "doctor": "npx expo-doctor",
    "check": "npm run typecheck && npx expo export --platform web",
    "verify": "npm run typecheck && npm run validate:i18n && npm run validate:language-memos && npm run validate:privacy && npm run validate:units && npm run validate:formatting && npm run validate:consent-recovery && npm run validate:reveal && npm run validate:accessibility && npm run validate:eas && npm run validate:targets && npm run validate:plan-builder && npm run validate:day-complete && npm run validate:portions && npm run validate:plan-editing && npm run validate:camera && npm run validate:german-search && npm run validate:recipes && npm run validate:meal-slots && npm run validate:preferences && npm run validate:meals && npm run validate:german && npm run validate:catalog && npm run validate:analysis-language && npm run validate:barcode && npm run validate:search && npm run validate:cache && npm run validate:matching && npm run validate:product && npm run validate:loop && npm run validate:supabase && npm run validate:subscription && npm run validate:site && npm run validate:site-images && npm run validate:store-listing && npm run validate:waitlist && npm run validate:language-routing && node --check server/index.mjs && npm run doctor && npx expo export --platform web",
    "validate:cache": "node scripts/validate-usda-cache.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "validate:release:production": "node scripts/validate-release.mjs --production",
    "validate:privacy": "node scripts/validate-privacy-consent.mjs",
    "accuracy": "node scripts/analyze-accuracy.mjs",
    "validate:loop": "node scripts/validate-daily-loop.mjs",
    "site:legal": "node scripts/build-site-legal.mjs",
    "validate:site": "node scripts/build-site-legal.mjs --check && node scripts/validate-site.mjs",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "preflight": "npm run verify && npm run validate:release",
    "validate:analysis-language": "node scripts/validate-analysis-language.mjs",
    "validate:matching": "node scripts/validate-usda-matching.mjs",
    "validate:units": "node scripts/validate-units.mjs",
    "validate:barcode": "node scripts/validate-barcode.mjs",
    "validate:search": "node scripts/validate-search.mjs",
    "validate:formatting": "node scripts/validate-formatting.mjs",
    "validate:consent-recovery": "node scripts/validate-consent-recovery.mjs",
    "validate:reveal": "node scripts/validate-result-reveal.mjs",
    "validate:accessibility": "node scripts/validate-accessibility.mjs",
    "validate:eas": "node scripts/validate-eas-env.mjs",
    "validate:day-complete": "node scripts/validate-day-complete.mjs",
    "validate:language-memos": "node scripts/validate-language-memos.mjs",
    "catalog:quick": "node scripts/tag-quick-meals.mjs",
    "validate:store-listing": "node scripts/validate-store-listing.mjs",
    "validate:site-images": "node scripts/validate-site-images.mjs",
    "validate:language-routing": "node scripts/validate-language-routing.mjs",
    "validate:waitlist": "node scripts/validate-waitlist.mjs",
    "validate:preferences": "node scripts/validate-preferences.mjs",
    "validate:meal-slots": "node scripts/validate-meal-slots.mjs",
    "validate:recipes": "node scripts/validate-recipes.mjs",
    "validate:german-search": "node scripts/validate-german-search.mjs",
    "validate:camera": "node scripts/validate-camera.mjs",
    "validate:plan-editing": "node scripts/validate-plan-editing.mjs",
    "validate:plan-builder": "node scripts/validate-plan-builder.mjs",
    "validate:portions": "node scripts/validate-portions.mjs",
    "validate:targets": "node scripts/validate-targets.mjs"
  },
  "private": true
}
