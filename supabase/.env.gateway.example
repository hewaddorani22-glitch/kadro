# Secrets for the hosted `nutrition` edge function.
# Copy to supabase/.env.gateway, fill in, then:
#   npx supabase secrets set --env-file supabase/.env.gateway
# supabase/.env.gateway is git-ignored and must never be committed.

OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=openai/gpt-4.1-mini
VISION_IMAGE_DETAIL=high

USDA_API_KEY=

# Independent server-only random salt used to pseudonymize the source network
# for nutrition search/barcode abuse limits. Never use EXPO_PUBLIC_.
NUTRITION_RATE_LIMIT_SALT=

# Hard ceiling of paid analyses per user per day. Barcode lookups are free and
# are not counted. Raise only with the provider bill in mind.
ANALYSIS_DAILY_LIMIT=60

# Service-wide UTC-day circuit breaker across all anonymous/user accounts.
# Set from the maximum provider spend you are willing to accept, then also set
# the provider's own hard spend cap and alerts. This is not a user entitlement.
GLOBAL_ANALYSIS_DAILY_LIMIT=1000

# Product allowance for active Kandro Pro customers. This counts successful or
# currently reserved Pro analyses; ANALYSIS_DAILY_LIMIT above remains the
# separate provider-attempt cost ceiling.
PRO_ANALYSIS_DAILY_LIMIT=60

# Server-only RevenueCat identifiers and credentials. Do not prefix any of
# these with EXPO_PUBLIC_. Project/App/Entitlement are RevenueCat internal IDs
# (proj..., app..., entl...), not the bundle ID or the `kandro_pro` lookup key.
# Product IDs are the comma-separated RevenueCat resources (`prod...`) for the
# iOS monthly/yearly subscriptions. Only Apple App Store subscriptions from
# this app and allowlist can unlock the gateway. Apple sandbox remains valid
# for TestFlight/App Review; RevenueCat Test Store is rejected by store type.
REVENUECAT_PROJECT_ID=
REVENUECAT_APP_ID=
REVENUECAT_ENTITLEMENT_RESOURCE_ID=
REVENUECAT_IOS_PRODUCT_RESOURCE_IDS=

# RevenueCat API v2 secret restricted to
# customer_information:subscriptions:read for the project above.
REVENUECAT_SECRET_API_KEY=

# Separate RevenueCat API v2 key restricted to
# customer_information:customers:read_write. It is used only by the
# authenticated delete-account function to erase the linked customer before
# the Supabase identity is removed.
REVENUECAT_ERASURE_API_KEY=

# Exact Authorization value configured on the RevenueCat webhook (for example
# `Bearer <long-random-value>`) plus the HMAC signing secret shown once when
# webhook signing is enabled. Use two independently generated values.
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNATURE_SECRET=

# Guardian-consent mail and abuse protection. Use a new random salt that is
# independent from WAITLIST_IP_SALT. GUARDIAN_CONSENT_FROM is optional and
# falls back to the verified WAITLIST_FROM sender. These values are server-only.
RESEND_API_KEY=
WAITLIST_FROM=
GUARDIAN_RATE_LIMIT_SALT=
GUARDIAN_CONSENT_FROM=
