{
  "expo": {
    "name": "Kandro",
    "slug": "kandro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kandro",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F5F3EE",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F3EE"
    },
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./locales/en.json",
      "de": "./locales/de.json"
    },
    "ios": {
      "supportsTablet": false,
      "appleTeamId": "85S69CVRAY",
      "bundleIdentifier": "com.hewaddorani.kandro",
      "infoPlist": {
        "NSCameraUsageDescription": "Kandro uses the camera to photograph your meal and estimate nutrition. The original photo is discarded after analysis and is not stored.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hewaddorani.kandro",
      "adaptiveIcon": {
        "backgroundColor": "#BBDC8E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kandro to photograph meals for analysis.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#3F5233"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7e8a6217-bd12-45e9-bbef-e72f5e183632"
      }
    },
    "owner": "hewad"
  }
}
