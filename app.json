{
  "expo": {
    "name": "Nutrition Autopilot",
    "slug": "nutrition-autopilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nutrition-autopilot",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nutritionautopilot.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Nutrition Autopilot uses your camera to scan meals. Photos stay on your device in this demo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nutrition Autopilot to photograph meals for analysis."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
